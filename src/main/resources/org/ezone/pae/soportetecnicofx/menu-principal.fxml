<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ezone.pae.soportetecnicofx.Controllers.MenuPrincipalController">

   <children>

      <MenuBar layoutX="0.0" layoutY="0.0" prefWidth="600.0">
         <menus>
            <Menu mnemonicParsing="false" text="Registros">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#abrirRegistroClientes" text="Clientes" />
                  <MenuItem mnemonicParsing="false" onAction="#abrirSolicitudServicio" text="Solicitud de servicio" />
               </items>
            </Menu>

            <Menu mnemonicParsing="false" text="Opciones">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#salir" text="Salir" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <Label layoutX="215.0" layoutY="150.0" text="Menú principal">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>

      <Separator layoutX="150.0" layoutY="190.0" prefWidth="300.0" />

      <Label layoutX="201.0" layoutY="215.0" text="Sistema de soporte técnico" />

   </children>

</AnchorPane>